{
  "name": "xenopi",
  "version": "0.1.0",
  "description": "XenoPi local coding agent on the Xenolith wire service",
  "piConfig": {
    "name": "xenopi",
    "configDir": ".xenopi"
  },
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=26"
  },
  "bin": {
    "xenopi": "dist/src/bin/xenopi.js"
  },
  "main": "./dist/src/index.js",
  "types": "./dist/src/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/src/index.d.ts",
      "import": "./dist/src/index.js"
    },
    "./provider": {
      "types": "./dist/src/extensions/provider.d.ts",
      "import": "./dist/src/extensions/provider.js"
    },
    "./branding": {
      "types": "./dist/src/extensions/branding.d.ts",
      "import": "./dist/src/extensions/branding.js"
    },
    "./mcp": {
      "types": "./dist/src/extensions/mcp.d.ts",
      "import": "./dist/src/extensions/mcp.js"
    }
  },
  "files": [
    "dist/src"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "prepack": "npm run build",
    "clean": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\"",
    "test": "npm run build && node --test \"dist/test/unit/*.test.js\"",
    "test:model": "npm run build && node --test --test-timeout=3600000 \"dist/test/model/*.test.js\""
  },
  "dependencies": {
    "@earendil-works/pi-ai": "0.84.2",
    "@earendil-works/pi-coding-agent": "0.84.2",
    "@modelcontextprotocol/sdk": "1.30.0",
    "typebox": "1.3.7"
  },
  "devDependencies": {
    "@earendil-works/pi-agent-core": "0.84.2",
    "@types/node": "26.2.0",
    "typescript": "5.9.3"
  }
}
